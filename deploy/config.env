# Standort-PIN aus der App "Mein Aramark Restaurant" (Freischalten per PIN).
# Entweder hier eintragen (nur in einem privaten Repo/Fork!) oder als Secret
# "kantine" mit Key KANTINE_PIN anlegen - das Secret hat Vorrang.
# KANTINE_PIN=12345678

# Abruf alle 6 h, nach einem Fehler erneut nach 15 min.
REFRESH_SECONDS=21600
RETRY_SECONDS=900

# Nur hinter einem Firmen-Proxy noetig - Python nutzt die Variablen automatisch:
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=.svc,.cluster.local
